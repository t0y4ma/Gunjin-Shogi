# /etc/caddy/Caddyfile の nine.freeddns.org のブロックを、次のように書き換える（Nine の設定はそのまま残る）
# ・/gunjin で始まる接続だけを軍人将棋のサーバー（127.0.0.1:7778）へ
# ・それ以外はこれまでどおり Nine のサーバー（127.0.0.1:27777）へ
# 軍人将棋のクライアントは wss://nine.freeddns.org/gunjin に接続する（ゲームサーバーはパスを見ないので、そのまま渡してよい）

nine.freeddns.org {
	handle /gunjin* {
		reverse_proxy 127.0.0.1:7778 {
			stream_timeout 1h
			stream_close_delay 30s
		}
	}

	handle {
		reverse_proxy 127.0.0.1:27777 {
			stream_timeout 1h
			stream_close_delay 30s
		}
	}
}
